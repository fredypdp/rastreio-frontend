+  const credenciaisApi = useApi(financeiroService.listarCredenciais);
+
+  const reload = async () => {
+    if (!codigoAcademia) return;
+    await Promise.all([
+      mensalidadesApi.execute({ codigo_academia: codigoAcademia }),
+      matriculasApi.execute({ codigo_academia: codigoAcademia }),
+    ]);
+  };
