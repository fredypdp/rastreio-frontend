+  const cursoEmEdicao = cursosAtivos.find(c => c.id === cursoSelecionado);
+
+  const anosFundamentalDisponiveis = user?.academia?.anos_academicos?.filter(a => a.endsWith("_ano_fundamental")) ?? [];
